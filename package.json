{
  "name": "ipl-auction-simulator",
  "version": "1.0.0",
  "description": "IPL Multiplayer Real-Time Auction Simulator",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "node tests/runAll.js",
    "test:live": "node tests/multiplayerSimulation.test.js",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:status": "node scripts/db/status.mjs",
    "db:import-json": "node scripts/db/import-json.mjs",
    "test:cloudflare": "node --test tests/cloudflareMigration.test.js tests/localWorkerdRuntime.test.js tests/e2eMultiplayerBrowser.test.js && node tests/doSecurityRules.test.js",
    "test:e2e": "npm --prefix client run build && node --test --test-concurrency=1 tests/e2e/",
    "test:session": "node tests/sessionLifecycle.test.js",
    "lint": "npm --prefix client run lint",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.1",
    "wrangler": "^3.114.17"
  }
}
